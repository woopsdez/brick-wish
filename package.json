{
  "name": "brick-wish",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node scripts/check-catalog.mjs",
    "shop-map": "node scripts/build-shop-map.mjs",
    "shop-map:sample": "node scripts/build-shop-map.mjs --sample",
    "preview": "vite preview",
    "build:pages": "BASE_PATH=/brick-wish/ npm run build",
    "catalog": "node scripts/build-catalog.mjs",
    "catalog:starter": "node scripts/starter-catalog.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  },
  "description": "子どもがレゴパーツを選んでカートに入れ、親がスマホで承認して BrickLink の Wanted List に流す家庭用おねがいカート"
