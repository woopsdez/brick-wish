# すべて任意。未設定ならローカルモード（同じ端末内だけで子→親のやりとりが完結）で動く。

# --- Supabase（親スマホと子タブレットを同期する場合） ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Web Push（親スマホに通知する場合）。`npx web-push generate-vapid-keys` で生成 ---
VITE_VAPID_PUBLIC_KEY=

# --- カタログ生成（scripts/build-catalog.mjs 用。ブラウザには渡らない） ---
REBRICKABLE_API_KEY=
